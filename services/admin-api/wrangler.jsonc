{
  "name": "la-cocina-administracion",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "vars": {
    "SITE_ORIGIN": "https://lacocinadelahistoria.github.io"
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
